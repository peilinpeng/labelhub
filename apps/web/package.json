{
  "name": "@labelhub/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=26.7.0 <27",
    "npm": ">=11.19.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "VITE_ENABLE_MSW=true VITE_DEMO_MODE=true vite build",
    "build:production": "VITE_ENABLE_MSW=false vite build",
    "audit:production": "node scripts/audit-production.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@formily/core": "^2",
    "@formily/react": "^2",
    "@labelhub/contracts": "file:../../packages/contracts",
    "@labelhub/schema-designer": "file:../../packages/schema-designer",
    "@labelhub/schema-compiler": "file:../../packages/schema-compiler",
    "@labelhub/schema-core": "file:../../packages/schema-core",
    "@labelhub/schema-renderer": "file:../../packages/schema-renderer",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "8.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "^30.1.0",
    "msw": "3.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "5.0.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}

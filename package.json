{
  "name": "labelhub",
  "version": "0.1.0",
  "private": true,
  "description": "LabelHub 数据标注平台",
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=11.20.0 <12"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "nanoid": "3.3.18"
  },
  "scripts": {
    "typecheck": "npm run -w @labelhub/contracts typecheck && npm run -w @labelhub/schema-core typecheck && npm run -w @labelhub/schema-compiler typecheck && npm run -w @labelhub/schema-renderer typecheck && npm run -w @labelhub/schema-designer typecheck && npm run -w @labelhub/workflow-core typecheck",
    "test": "npm run -w @labelhub/contracts test && npm run -w @labelhub/schema-core test && npm run -w @labelhub/schema-compiler test && npm run -w @labelhub/schema-renderer test && npm run -w @labelhub/schema-designer test && npm run -w @labelhub/workflow-core test",
    "test:contracts": "npm run -w @labelhub/contracts test",
    "test:schema-core": "npm run -w @labelhub/schema-core test",
    "test:schema-compiler": "npm run -w @labelhub/schema-compiler test",
    "test:schema-renderer": "npm run -w @labelhub/schema-renderer test",
    "test:schema-designer": "npm run -w @labelhub/schema-designer test",
    "test:workflow-core": "npm run -w @labelhub/workflow-core test",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "build:migration-engine": "tsc -p scripts/tsconfig.json && node scripts/build-migration-engine.mjs",
    "check:docs": "node scripts/run-python.mjs scripts/check-docs.py",
    "check:storage": "node scripts/run-python.mjs scripts/local-compose.py --check",
    "compose": "node scripts/run-python.mjs scripts/local-compose.py",
    "ops": "node scripts/run-python.mjs scripts/local_ops.py",
    "test:ops": "node scripts/run-python.mjs -m unittest discover -s scripts/tests -v",
    "backup:prepare": "node scripts/run-python.mjs scripts/recovery_backup.py prepare",
    "backup:copy": "node scripts/run-python.mjs scripts/recovery_backup.py copy",
    "backup:verify": "node scripts/run-python.mjs scripts/recovery_backup.py verify",
    "backup:restore-check": "node scripts/run-python.mjs scripts/recovery_backup.py restore-check"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "esbuild": "0.28.2"
  }
}
